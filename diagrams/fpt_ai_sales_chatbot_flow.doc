<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'><code style="background-color:#f0f0f0; color:#c7254e; padding:2px 4px; font-family:Consolas, monospace; font-size:9.5pt;">A-&gt;&gt;B: "Msg"</code></td>
