<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'>Khách hàng tương tác trực tiếp trên giao diện Web <code style="background-color:#f0f0f0; color:#c7254e; padding:2px 4px; font-family:Consolas, monospace; font-size:9.5pt;">fpt.vn</code></td>
<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'><code style="background-color:#f0f0f0; color:#c7254e; padding:2px 4px; font-family:Consolas, monospace; font-size:9.5pt;">actor Customer</code></td>
</tr>
<tr style='border-bottom:1px solid #dddddd;'>
<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'><code style="background-color:#f0f0f0; color:#c7254e; padding:2px 4px; font-family:Consolas, monospace; font-size:9.5pt;">participant</code></td>
<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'>Các dịch vụ/hệ thống (AI Chatbot, Hệ thống Lõi FPT, Telesales CRM/CSKH Desk)</td>
<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'><code style="background-color:#f0f0f0; color:#c7254e; padding:2px 4px; font-family:Consolas, monospace; font-size:9.5pt;">participant Name</code></td>
</tr>
<tr style='border-bottom:1px solid #dddddd;'>
<td style='border:1px solid #dddddd; padding:8px; vertical-align:top;'><code style="background-color:#f0f0f0; color:#c7254e; padding:2px 4px; font-family:Consolas, monospace; font-size:9.5pt;">-&gt;&gt;</code></td>
